<mvc:View 
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:core="sap.ui.core"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:layout="sap.ui.layout.cssgrid"
  >

		<f:GridList
			id="gridListId"
			headerText="{i18n>GridListHeader}"
			items="{ path : '_EmployeeSkills' }"      
      width="auto" 
      >
      <f:customLayout>
      <layout:GridBoxLayout id="layoutId"
                            boxesPerRowConfig="XL6 L4 M3 S1" 
                            >  
      </layout:GridBoxLayout>    
      </f:customLayout>                 
			<f:GridListItem id="gridListItemId" >           
				<VBox id="vboxId" 
              class="sapUiResponsiveMargin"  >
					<layoutData>
						<FlexItemData id="flexItemDataId"/> 
					</layoutData>
					    <Title id="titleId"
                     text="{Skillname}"
                        />      
                        <Text id="textID"
                              text="{Skillarea}" 
                        >      
                        </Text>
                            <RatingIndicator id="ratingId"
                                             value="{Rating}"
                                             maxValue="10"
                                             visualMode="Half"
                                             editable="{= ${ui>/editMode} === 'Display' ? false : true }"
                            >
				                    </RatingIndicator> 
                                        
				</VBox>
			</f:GridListItem>
		</f:GridList>
</mvc:View>	